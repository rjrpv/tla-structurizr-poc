#!/usr/bin/env bash
# Pre-commit: keep the architecture baselines in sync with the code.
#
# The observer watches two packages (see code/observe.py TARGETS):
#   reservation -> code/reservation   (baseline: code/baseline.json)
#   examples    -> examples/code      (baseline: examples/baseline.json)
# If this commit changes a watched package, its baseline is regenerated from
# the working tree and re-staged, so the commit records the accepted structure.
#
# This is the local convenience half of the acceptance loop. The CI gate
# (code/observe.py --check) enforces the same invariant for everyone, so a
# commit that skips this hook still can't merge.
#
# Install: git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# target:git-path:baseline-file
WATCHED=(
  "reservation:code/reservation:code/baseline.json"
  "examples:examples/code:examples/baseline.json"
)

for entry in "${WATCHED[@]}"; do
  target="${entry%%:*}"
  rest="${entry#*:}"
  pkg="${rest%%:*}"
  baseline="${rest#*:}"

  # Are any files under this watched package in the index?
  changed="$(git diff --cached --name-only -- "$pkg" || true)"
  [ -z "$changed" ] && continue

  python3 "$ROOT/code/observe.py" --save-baseline --target "$target" >/dev/null
  git add "$baseline"
  echo "pre-commit: baseline regenerated for $pkg change" >&2
done
